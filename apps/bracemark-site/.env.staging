# Loaded by `nx build bracemark-site --configuration=staging` via the target's
# `envFile` option (Nx loads it into process.env, overriding Next's auto-loaded
# .env.production). All vars are NEXT_PUBLIC_* and baked into the static bundle —
# nothing secret belongs here.
NEXT_PUBLIC_API_URL=https://api.staging.bracemark.com

# Where the "Sign in" / "Get Started" links go. The marketing site never renders the
# app itself — it hands off to bracemark-web at the `app.` host (docs/deployment.md).
NEXT_PUBLIC_APP_URL=https://app.staging.bracemark.com
