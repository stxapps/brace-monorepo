{
  "name": "@stxapps/bracemark-site",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "tags": [
      "type:app",
      "platform:web"
    ],
    "targets": {
      "build": {
        "configurations": {
          "staging": {
            "envFile": "apps/bracemark-site/.env.staging"
          }
        },
        "outputs": [
          "{projectRoot}/.next/!(cache)/**/*",
          "{projectRoot}/.next/!(cache)",
          "{projectRoot}/out"
        ]
      },
      "dev": {
        "options": {
          "command": "next dev --port 3001"
        }
      },
      "start": {
        "options": {
          "command": "next start --port 3001"
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stxapps/shared": "*",
    "@stxapps/web-ui": "*",
    "next": "~16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "tailwindcss": "^4.3.0"
  }
}
